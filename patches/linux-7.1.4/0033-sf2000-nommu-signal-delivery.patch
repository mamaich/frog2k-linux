From: SF2000 Linux <sf2000@localhost>
Subject: [PATCH] mips: sf2000: deliver signals to NOMMU userspace

NOMMU user images execute in kernel mode, so the exception return path
cannot use KU_USER to recognise a return to userspace.  It compared the
saved EPC against the fixed 0x84000000-0x87ffffff window instead, which
only ever described the optional ET_EXEC application window.  Static-PIE
images - the default userspace - are placed by vm_mmap wherever the
allocator has room (0x82600000 and 0x82700000 on a 128 MiB board), so
their frames were classified as kernel returns and work_pending, and
with it do_notify_resume(), never ran for any user process.

The result was that no signal was ever delivered to userspace.  Signals
were queued but never dequeued, so signal_pending() stayed true forever,
every interruptible syscall then returned -ERESTARTSYS, and processes
lost their I/O: a shell exited with the status of the last command as
soon as one of its children terminated, and handlers installed with
sigaction() never ran.

Record the physical range of the image the loader placed for the task
and test the saved EPC against that range instead.  The comparison masks
the address so the KSEG0, KSEG1 and identity aliases of the same image
all match, kernel frames stay outside every user range, and tasks that
never ran a user image (kernel threads) keep a zero range that no EPC
can fall into.

diff --git a/arch/mips/kernel/entry.S b/arch/mips/kernel/entry.S
--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -44,10 +44,14 @@
 #if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
 	bnez	t0, resume_userspace
 	LONG_L	t0, PT_EPC(sp)
-	li	t1, 0xfc000000
-	and	t0, t1
-	li	t1, 0x84000000
-	bne	t0, t1, resume_kernel
+	li	t1, 0x1fffffff		# KSEG0/KSEG1/identity all alias the
+	and	t0, t0, t1		# same physical image range
+	LONG_L	t1, TI_USER_START($28)
+	LONG_L	t2, TI_USER_END($28)
+	sltu	t1, t0, t1		# epc below this task's image?
+	bnez	t1, resume_kernel
+	sltu	t2, t0, t2		# epc inside this task's image?
+	beqz	t2, resume_kernel
 #else
 	beqz	t0, resume_kernel
 #endif
@@ -219,10 +223,14 @@
 #if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
 	bnez	t0, 1f
 	LONG_L	t0, PT_EPC(sp)
-	li	t1, 0xfc000000
-	and	t0, t1
-	li	t1, 0x84000000
-	bne	t0, t1, resume_kernel
+	li	t1, 0x1fffffff		# KSEG0/KSEG1/identity all alias the
+	and	t0, t0, t1		# same physical image range
+	LONG_L	t1, TI_USER_START($28)
+	LONG_L	t2, TI_USER_END($28)
+	sltu	t1, t0, t1
+	bnez	t1, resume_kernel
+	sltu	t2, t0, t2
+	beqz	t2, resume_kernel
 1:
 #else
 	beqz	t0, resume_kernel
diff --git a/arch/mips/include/asm/thread_info.h b/arch/mips/include/asm/thread_info.h
--- a/arch/mips/include/asm/thread_info.h
+++ b/arch/mips/include/asm/thread_info.h
@@ -30,6 +30,17 @@
 	int			preempt_count;	/* 0 => preemptible, <0 => BUG */
 	struct pt_regs		*regs;
 	long			syscall;	/* syscall number */
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+	/*
+	 * NOMMU user images run in kernel mode, so KU_USER cannot tell a
+	 * return to userspace from a return to the kernel.  The ELF loader
+	 * records the physical range of this task's image (code, data and
+	 * stack); an exception frame whose EPC falls inside it was taken in
+	 * userspace.
+	 */
+	unsigned long		user_start;
+	unsigned long		user_end;
+#endif
 };
 
 /*
diff --git a/arch/mips/kernel/asm-offsets.c b/arch/mips/kernel/asm-offsets.c
--- a/arch/mips/kernel/asm-offsets.c
+++ b/arch/mips/kernel/asm-offsets.c
@@ -110,6 +110,10 @@
 	OFFSET(TI_PRE_COUNT, thread_info, preempt_count);
 	OFFSET(TI_REGS, thread_info, regs);
 	OFFSET(TI_SYSCALL, thread_info, syscall);
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+	OFFSET(TI_USER_START, thread_info, user_start);
+	OFFSET(TI_USER_END, thread_info, user_end);
+#endif
 	DEFINE(_THREAD_SIZE, THREAD_SIZE);
 	DEFINE(_THREAD_MASK, THREAD_MASK);
 	DEFINE(_IRQ_STACK_SIZE, IRQ_STACK_SIZE);
diff --git a/fs/binfmt_elf_nommu.c b/fs/binfmt_elf_nommu.c
--- a/fs/binfmt_elf_nommu.c
+++ b/fs/binfmt_elf_nommu.c
@@ -408,6 +408,21 @@
 	if (retval)
 		goto out_fatal;
 
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+	/*
+	 * Publish the physical image range before the handoff: the exception
+	 * return path uses it to recognise a return to this task's userspace.
+	 */
+	if (is_pie) {
+		current_thread_info()->user_start = CPHYSADDR(maddr);
+		current_thread_info()->user_end = CPHYSADDR(maddr + alloc_size);
+	} else {
+		current_thread_info()->user_start =
+			CPHYSADDR(ELF_NOMMU_VADDR_START);
+		current_thread_info()->user_end =
+			CPHYSADDR(ELF_NOMMU_VADDR_END);
+	}
+#endif
 	entry = CPHYSADDR(entry);
 	current->mm->start_stack = CPHYSADDR(current->mm->start_stack);
 
